# Default: local SQLite (no Docker). Run: npx prisma db push
DATABASE_URL="file:./prisma/dev.db"

# Optional: PostgreSQL instead (docker compose up -d)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skypulse?schema=public"

# Same value in bridge env, or leave empty in dev to use built-in local fallback (see src/lib/bridge-auth.ts)
BRIDGE_SECRET="replace-with-a-long-random-string"
