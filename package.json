{
  "name": "skytracker-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:ipv4": "next dev -H 127.0.0.1 -p 3000",
    "build": "dotenv -e .env.example -- prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "dotenv -e .env.example -- prisma generate",
    "db:regenerate": "node -e \"try{require('fs').rmSync(require('path').join('node_modules','.prisma'),{recursive:true,force:true})}catch(e){}\" && dotenv -e .env.example -- prisma generate",
    "db:push": "dotenv -e .env.example -- prisma db push",
    "db:migrate": "dotenv -e .env.example -- prisma migrate dev",
    "msfs:setup": "dotenv -e .env.example -- prisma db push && npm install --prefix bridge",
    "msfs:bridge": "npm run start --prefix bridge"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@tailwindcss/postcss": "^4.3.0",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "16.2.6",
    "postcss": "^8.5.14",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.0",
    "typescript": "^5"
  }
}
